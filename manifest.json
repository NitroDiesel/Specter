{
  "manifest_version": 3,
  "name": "Specter",
  "description": "Keep supported tabs active with private, per-site visibility and focus controls.",
  "version": "1.0.0",
  "author": "NitroDiesel",
  "homepage_url": "https://github.com/NitroDiesel/Specter",
  "default_locale": "en",
  "icons": {
    "16": "assets/icons/specter-16.png",
    "32": "assets/icons/specter-32.png",
    "48": "assets/icons/specter-48.png",
    "128": "assets/icons/specter-128.png"
  },
  "action": {
    "default_title": "Specter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/specter-16.png",
      "32": "assets/icons/specter-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["assets/overlay.css"],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "specter@opensource",
      "strict_min_version": "128.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "object-src 'none'; base-uri 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
  },
  "commands": {
    "toggle-global": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Toggle Specter globally"
    },
    "toggle-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Toggle spoofing for the active tab"
    }
  }
}
